{
  "name": "ktp-kit",
  "version": "0.1.1",
  "description": "Read Indonesian KTPs on the user's device: camera guidance, all 16 fields, region codes. No upload, works offline.",
  "keywords": [
    "ktp",
    "e-ktp",
    "ocr",
    "indonesia",
    "nik",
    "ekyc",
    "on-device",
    "offline",
    "web-component"
  ],
  "license": "Apache-2.0",
  "homepage": "https://ktp-kit.khusyasy.my.id",
  "repository": {"type": "git", "url": "git+https://github.com/Khusyasy/ktp-kit.git", "directory": "packages/ktp-kit"},
  "author": "Muhammad Luthfi Khusyasy",
  "type": "module",
  "imports": {
    "#ort": {"browser": "./src/ort.js", "node": "./src/ort.server.js", "default": "./src/ort.js"}
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./element": {
      "types": "./types/element.d.ts",
      "default": "./src/element.js"
    },
    "./engine": {
      "types": "./types/engine.d.ts",
      "default": "./src/engine.js"
    },
    "./capture": {
      "types": "./types/capture.d.ts",
      "default": "./src/capture.js"
    },
    "./parser": {
      "types": "./types/ktp.d.ts",
      "default": "./src/ktp.js"
    },
    "./ort": {
      "types": "./types/ort.d.ts",
      "browser": "./src/ort.js",
      "node": "./src/ort.server.js",
      "default": "./src/ort.js"
    },
    "./nik": {
      "types": "./types/nik.d.ts",
      "default": "./src/nik.js"
    }
  },
  "bin": {
    "ktp-kit": "./bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "LICENSE",
    "NOTICE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "types",
    "PRIVACY.md"
  ],
  "dependencies": {
    "@ktp-kit/models": "0.1.0",
    "brotli-dec-wasm": "^2.3.2",
    "jpeg-js": "0.4.4",
    "onnxruntime-web": "1.20.1"
  },
  "sideEffects": [
    "./src/element.js"
  ],
  "scripts": {
    "prepack": "npm run types --prefix ../.. && cp ../../LICENSE ../../NOTICE ../../README.md ../../THIRD_PARTY_NOTICES.md ../../PRIVACY.md . && rm -rf LICENSES && cp -r ../../LICENSES ."
  },
  "types": "./types/index.d.ts"
}
